  "project": "name: HeadLink\noptions:\n  minimumXcodeGenVersion: 2.44.1\n  deploymentTarget:\n    iOS: '17.0'\n  developmentLanguage: zh-Hans\n  xcodeVersion: '26.1.1'\npackages:\n  HeadLink:\n    path: .\n  OpenCine:\n    path: Vendor/OpenCine\nsettings:\n  base:\n    SWIFT_VERSION: '5.0'\n    TARGETED_DEVICE_FAMILY: '1'\n    CODE_SIGNING_ALLOWED: NO\n    CODE_SIGNING_REQUIRED: NO\n    ENABLE_USER_SCRIPT_SANDBOXING: YES\n    MARKETING_VERSION: 1.2.2\n    CURRENT_PROJECT_VERSION: 1\ntargets:\n  HeadLink:\n    type: application\n    platform: iOS\n    sources:\n      - path: App\n        excludes: [Info.plist]\n    info:\n      path: App/Info.plist\n      properties:\n        CFBundleDisplayName: HeadLink\n        CFBundleShortVersionString: $(MARKETING_VERSION)\n        CFBundleVersion: $(CURRENT_PROJECT_VERSION)\n        CFBundleDevelopmentRegion: zh-Hans\n        UILaunchScreen: {}\n        UIUserInterfaceStyle: Dark\n        UISupportedInterfaceOrientations:\n          - UIInterfaceOrientationPortrait\n          - UIInterfaceOrientationLandscapeLeft\n          - UIInterfaceOrientationLandscapeRight\n        NSMotionUsageDescription: \u4f7f\u7528\u8033\u673a\u7684\u5934\u90e8\u59ff\u6001\uff0c\u8ba1\u7b97\u4f60\u6821\u51c6\u540e\u7684\u955c\u5934\u65b9\u5411\uff1b\u6570\u636e\u53ea\u5728\u672c\u673a\u5904\u7406\u3002\n        NSBluetoothAlwaysUsageDescription: \u67e5\u627e\u5e76\u914d\u5bf9\u4f60\u81ea\u5df1\u7684 Pocket \u76f8\u673a\u3002\n        NSLocalNetworkUsageDescription: \u901a\u8fc7\u76f8\u673a Wi-Fi \u63a5\u6536\u5b9e\u65f6\u753b\u9762\u3001\u8bfb\u53d6\u72b6\u6001\u5e76\u53d1\u9001\u63a7\u5236\u547d\u4ee4\u3002\n        ITSAppUsesNonExemptEncryption: false\n    settings:\n      base:\n        PRODUCT_BUNDLE_IDENTIFIER: org.headlink.personal\n        GENERATE_INFOPLIST_FILE: NO\n        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon\n    dependencies:\n      - package: HeadLink\n        product: HeadLinkCore\n      - package: OpenCine\n        product: OpenCineDJI\n      - package: OpenCine\n        product: OpenCineDJIApple\n      - package: OpenCine\n        product: OpenCineMotion\n      - package: OpenCine\n        product: OpenCineApple\n  HeadLinkSmoke:\n    type: application\n    platform: iOS\n    sources: [Smoke]\n    settings:\n      base:\n        PRODUCT_BUNDLE_IDENTIFIER: org.headlink.smoke\n        GENERATE_INFOPLIST_FILE: YES\n        INFOPLIST_KEY_UILaunchScreen_Generation: YES\n  HeadLinkUITests:\n    type: bundle.ui-testing\n    platform: iOS\n    sources: [UITests]\n    dependencies:\n      - target: HeadLink\n    settings:\n      base:\n        PRODUCT_BUNDLE_IDENTIFIER: org.headlink.ui-tests\n        GENERATE_INFOPLIST_FILE: YES\n        TEST_TARGET_NAME: HeadLink\nschemes:\n  HeadLink:\n    build:\n      targets:\n        HeadLink: all\n  HeadLinkSmoke:\n    build:\n      targets:\n        HeadLinkSmoke: all\n  HeadLinkUIReview:\n    build:\n      targets:\n        HeadLink: all\n        HeadLinkUITests: [test]\n    test:\n      targets: [HeadLinkUITests]\n",
  "deviceWorkflow": "name: iPhone unsigned build\non:\n  workflow_dispatch:\npermissions:\n  contents: read\nconcurrency:\n  group: headlink-ios-${{ github.ref }}\n  cancel-in-progress: true\njobs:\n  build:\n    runs-on: macos-15\n    timeout-minutes: 25\n    env:\n      DEVELOPER_DIR: /Applications/Xcode_26.1.1.app/Contents/Developer\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n        with:\n          persist-credentials: false\n      - name: Verify dependency tree\n        run: python3 scripts/verify-vendor.py\n      - name: Generate native projects\n        run: bash scripts/install-xcodegen.sh\n      - name: Minimal physical-device SDK check\n        run: |\n          mkdir -p build/logs\n          set -o pipefail\n          xcodebuild -project HeadLink.xcodeproj -scheme HeadLinkSmoke -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath build/Smoke CODE_SIGNING_ALLOWED=NO build | tee build/logs/smoke.log\n      - name: Core and protocol tests\n        run: |\n          set -o pipefail\n          bash scripts/test-core.sh | tee build/logs/core-tests.log\n      - name: Physical-device build and packaging\n        run: bash scripts/build-unsigned.sh\n      - name: Retain device artifact and evidence\n        if: always()\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n        with:\n          name: HeadLink-unsigned-${{ github.run_number }}\n          path: |\n            build/HeadLink-unsigned.ipa\n            build/build-metadata.json\n            build/SHA256SUMS\n            build/logs\n            build/device-build.xcresult\n          retention-days: 3\n          if-no-files-found: warn\n"
